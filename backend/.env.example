FRONTEND_URL=frontend url
PORT=port number

GITHUB_TOKEN=your_github_personal_access_token_here
GROQ_API_KEY=your_groq_api_key_here
GROQ_PARALLEL_REQUESTS=4
GROQ_RATE_LIMIT_WAIT_MS=60000
GROQ_MAX_RETRY_CYCLES=30
DATABASE_URL="postgresql://<user>:<password>@<neon-pooled-host>/<db>?sslmode=require&pgbouncer=true&connect_timeout=15"
DIRECT_URL="postgresql://<user>:<password>@<neon-direct-host>/<db>?sslmode=require&connect_timeout=15"